POSTGRES_USER=finances
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finances
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars
DATABASE_URL=postgres://finances:change-me@localhost:5442/finances?sslmode=disable
HTTP_ADDR=:8080
RESEND_API_KEY=change-me

# Auth (phase 3). Placeholders only: put real values in .env, never here.
# JWT_SECRET must be at least 32 bytes, e.g. from `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=onboarding@resend.dev
APP_BASE_URL=http://localhost:5173

# Email reminders (phase 7). All optional; these are the defaults.
# TZ_NAME defines "today" for due dates; DISK_PROBE_PATH is the directory whose
# filesystem is measured for the disk alert (DISK_ALERT_PCT = used percent, 1 to 99).
#REMINDERS_ENABLED=true
#TZ_NAME=America/Mexico_City
#DISK_ALERT_PCT=80
#DISK_PROBE_PATH=/probe
