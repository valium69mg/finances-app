# Site configuration. The official nginx image renders this template with envsubst at
# start (only ${DOMAIN}; see NGINX_ENVSUBST_FILTER in docker-compose.prod.yml).
# Inside the container nginx listens on 8080 and 8443 (non-root); compose publishes them
# as 80 and 443.

# --- Plain HTTP: container health check and redirect to HTTPS -----------------------
# Any Host other than DOMAIN (including direct-IP scans) is dropped.
server {
    listen 8080 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 444;
    }
}

server {
    listen 8080;
    server_name ${DOMAIN};

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- HTTPS: unknown SNI is refused before any certificate is presented ----------------
server {
    listen 8443 ssl default_server;
    http2 on;
    server_name _;
    ssl_reject_handshake on;
}

# --- HTTPS: the application -------------------------------------------------------------
server {
    listen 8443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    root /usr/share/nginx/html;
    index index.html;

    limit_conn perip 30;
    client_max_body_size 1m;   # JSON bodies; the backend caps them at 1 MiB too

    include /etc/nginx/snippets/security-headers.conf;

    # Auth endpoints: strict per-IP rate on top of the per-email and per-IP limits of the
    # backend (nginx cannot read the JSON body, so the per-email limit stays in the app).
    location /api/auth/ {
        limit_req zone=auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Invoice uploads: XML (1 MiB) + PDF (10 MiB) + multipart overhead; the backend caps
    # the request at 12 MiB. Only these two routes accept a large body.
    location ~ ^/api/invoices/[0-9]+/(issue|documents)$ {
        limit_req zone=api burst=10 nodelay;
        client_max_body_size 13m;
        client_body_timeout 60s;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Hashed build assets never change: cache them for a year. A missing asset is a 404,
    # never the SPA shell.
    location /assets/ {
        limit_req zone=web burst=60 nodelay;
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The SPA shell and any client-side route: never cached, so a new build is picked up
    # at once (its asset names change on every build).
    location / {
        limit_req zone=web burst=60 nodelay;
        try_files $uri /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        add_header Cache-Control "no-store" always;
    }

    # Dotfiles are never served (the SPA fallback would otherwise answer with the shell).
    location ~ /\.(?!well-known) {
        return 404;
    }

    # JSON bodies for nginx's own errors on /api/ so the client always gets the envelope.
    location @rate_limited {
        internal;
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "5" always;
        return 429 '{"error":"rate_limited"}\n';
    }
    location @too_large {
        internal;
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 413 '{"error":"request_too_large"}\n';
    }
    location @upstream_unavailable {
        internal;
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 502 '{"error":"upstream_unavailable"}\n';
    }
}
