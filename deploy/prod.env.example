# Production environment for deploy/docker-compose.prod.yml.
# Copy to deploy/.env.prod (gitignored), fill EVERY value, and never commit the copy:
#   cp deploy/prod.env.example deploy/.env.prod && chmod 600 deploy/.env.prod
# Every secret below is a placeholder: the API refuses to start while one still contains
# CHANGE_ME, and docker compose refuses to start while a required value is missing.
#
# Generate secrets with:  openssl rand -hex 32
# Use hex or alphanumeric passwords only: they are embedded in connection URLs.

# Public host name served through Cloudflare (no scheme, no path).
DOMAIN=finances.example.com

# Frontend origin used in the verification emails and the CORS check. Defaults to
# https://$DOMAIN; set it only if it differs.
#APP_BASE_URL=https://finances.example.com

# PostgreSQL (never published outside the stack).
POSTGRES_USER=finances
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=finances

# MinIO root credentials, used by the API for the private invoice bucket.
# The password needs at least 8 characters.
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
#S3_BUCKET=finances-invoices

# JWT signing secret (HS256), at least 32 bytes.
JWT_SECRET=CHANGE_ME_jwt_secret_openssl_rand_hex_32

# Resend (email verification). RESEND_FROM must be a sender Resend accepts for your
# account; onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=CHANGE_ME_resend_api_key
#RESEND_FROM=onboarding@resend.dev

# Email reminders (bills, weekly summary, disk alert). The disk alert measures the data
# volume through the empty directory /srv/finances/probe on the VM, mounted read-only at
# /probe (create it once: sudo mkdir -p /srv/finances/probe). Defaults shown.
#REMINDERS_ENABLED=true
#TZ_NAME=America/Mexico_City
#DISK_ALERT_PCT=80

# Host directory with the Cloudflare Origin CA certificate: origin.pem and origin.key.
TLS_CERT_DIR=/etc/finances/certs

# Host ports nginx publishes. Leave the defaults on the VM; change them only for a local
# smoke test next to other services.
#HTTP_PORT=80
#HTTPS_PORT=443

# Compose project name (prefix of the containers, network and volumes).
#COMPOSE_PROJECT_NAME=finances-prod

# The API trusts the X-Real-IP header only from this peer: the nginx container, which has
# a fixed address on the internal network. Do not change it without changing the subnet in
# docker-compose.prod.yml.
#TRUSTED_PROXIES=172.29.42.10
