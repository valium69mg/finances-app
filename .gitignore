# Secrets
.env
.env.*
!.env.example

# Production stack: TLS material and per-host nginx extras never enter git.
deploy/certs/
deploy/nginx/optional/*.conf

# Terraform: state, variables and SSH keys never enter git (the repo is public).
# The provider lock file (.terraform.lock.hcl) IS committed on purpose.
infra/.keys/
infra/backend.hcl
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
*.pem
*.key
id_ed25519*
id_rsa*

# Go
backend/bin/
*.test
*.out

# Node
node_modules/
dist/
playwright-report/
test-results/

# Editors / OS
.idea/
.vscode/
.DS_Store
.atl/
